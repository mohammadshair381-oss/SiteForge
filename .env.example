# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or expose these values to the browser.

# MongoDB connection string (required).
#
# MUST point at a MongoDB REPLICA SET, not a standalone `mongod`. The payments
# webhook and the membership routes use multi-document transactions, which a
# standalone server rejects with:
#   "Transaction numbers are only allowed on a replica set member or mongos"
#
# Atlas (mongodb+srv://...) clusters are always replica sets, support
# transactions on every tier, and work here unchanged -- no application code
# changes are needed.
#
# For local development, run a single-node replica set instead of a bare mongod:
#   Option 1 -- local mongod:
#     mongod --replSet rs0 --dbpath <path> --bind_ip 127.0.0.1
#     mongosh --eval "rs.initiate()"
#   Option 2 -- container (optional; Docker is NOT required):
#     docker run -d --name siteforge-mongo -p 27017:27017 mongo:7 --replSet rs0 --bind_ip_all
#     docker exec siteforge-mongo mongosh --eval "rs.initiate()"
#
# Readiness check: do not connect until the node reports PRIMARY. Wait for this
# command to print `true`:
#   mongosh --quiet --eval "db.hello().isWritablePrimary"
#   (container form: docker exec siteforge-mongo mongosh --quiet --eval "db.hello().isWritablePrimary")
#
# Note the ?replicaSet=rs0 suffix on the local URI:
MONGODB_URI=mongodb://127.0.0.1:27017/saas_website_builder?replicaSet=rs0

# Optional per-instance MongoDB connection pool cap (whole number 1-50,
# default 10). Serverless hosts run many instances, each with its own pool,
# against the cluster's shared connection limit (Atlas free tier: 500).
MONGODB_MAX_POOL_SIZE=

# Secret used to sign session JWTs (required). Must be at least 32 characters.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Public base domain used for storefront subdomains (no protocol)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Comma separated list of root domains that map to storefront subdomains
ROOT_DOMAINS=localhost:3000

# --- Payments (optional). Leave blank to keep billing in manual/sandbox mode. ---
# Never invent production credentials.
PAYMENT_PROVIDER=manual
# The legacy generic webhook (/api/webhooks/payments). It cannot re-read anything from a
# provider, so it stays off unless this is set, and it is never available with
# PAYMENT_PROVIDER=razorpay, whose webhook has its own secret below. Keep it empty.
PAYMENT_WEBHOOK_SECRET=
# In production the legacy webhook also needs this exact opt-in. Leave it off.
LEGACY_PAYMENT_WEBHOOK_ENABLED=false

# Explicit opt-in required to activate PAID plans manually in production.
# Outside production, manual activation always works. Leave unset in production.
ALLOW_MANUAL_BILLING=false

# SaaS subscription billing through Razorpay Subscriptions (lib/billing-razorpay.ts).
# Used only with PAYMENT_PROVIDER=razorpay. This is SiteForge's OWN Razorpay account
# for charging store owners, separate from each store's account for shopper checkout.
# Use test keys (rzp_test_...). Live keys (rzp_live_...) are refused unless
# BILLING_LIVE_ALLOWED=true, which needs its own approval.
RAZORPAY_BILLING_KEY_ID=
RAZORPAY_BILLING_KEY_SECRET=
RAZORPAY_BILLING_WEBHOOK_SECRET=
BILLING_LIVE_ALLOWED=false
# Days a store keeps its paid features after a failed renewal (0-30, default 3).
BILLING_GRACE_DAYS=3

# --- Proxy / rate limiting ---
# Name of the request header your reverse proxy sets to the REAL client IP
# (e.g. "x-real-ip" or "x-forwarded-for"). Only set this if your proxy
# overwrites/sanitizes the header — otherwise clients could spoof it.
# REQUIRED in production: without it (or when a request omits it) rate-limited
# endpoints fail closed with HTTP 503 `rate_limit_misconfigured` rather than
# sharing one global bucket. Leave blank in local development to use the shared
# bucket. Rate-limit keys are HMAC-hashed with SESSION_SECRET, so raw IPs/emails
# are never stored.
#
# DEPLOYMENT PREREQUISITE (not an application change): this value is dictated by
# whichever reverse proxy / load balancer / PaaS sits in front of this app, so
# it cannot be chosen here. Pick the header your proxy actually sets and is
# guaranteed to overwrite, set the same name in this file, then smoke-test:
#   1. curl -i https://<your-domain>/api/auth/login  -> must NOT be 503
#      (`rate_limit_misconfigured`).
#   2. Repeat the request until it returns 429, proving per-client limiting is
#      live rather than one global bucket.
# Do NOT set a forwarding header you have not verified your proxy overwrites.
TRUSTED_IP_HEADER=

# --- Email ---
# Transport used by lib/email.ts. One of: resend | console | memory.
#   resend  -> real delivery through the Resend HTTP API (production choice).
#   console -> local development only: logs a redacted line, never the body or
#              links. It is REFUSED in production.
#   memory  -> in-memory outbox for automated tests. It is REFUSED in
#              production.
# Leave EMAIL_PROVIDER empty to use `console` in development. In production
# EMAIL_PROVIDER=resend is MANDATORY: without it (or with console/memory, or
# incomplete Resend settings) the startup check fails and requests answer 500
# (the process may keep running; use a /login health check), because password
# reset needs an emailed code. See docs/email-delivery.md. No SDK is used; Resend
# is called with the native fetch API.
EMAIL_PROVIDER=

# Resend API key (required when EMAIL_PROVIDER=resend; starts with "re_").
# Never commit a real key.
EMAIL_API_KEY=

# Sender shown on outgoing email. Accepts a bare address or
# "Display Name <address>". The address must belong to a domain you have
# verified with the provider. Replace the placeholder below with your own.
EMAIL_FROM=SiteForge <no-reply@example.com>

# Optional Reply-To address (validated when set).
EMAIL_REPLY_TO=

# Development only: print the 6-digit password reset code in the SERVER
# terminal (signup and login need no code), e.g.
#   [auth] Development password reset code for j***@example.com: 942041
# Useful with EMAIL_PROVIDER=console, which never shows email bodies. It prints
# only when ALL hold: this is exactly "true", NODE_ENV is exactly "development"
# (`npm run dev`), and EMAIL_PROVIDER is explicitly "console" or "memory" (an
# empty provider is not enough). Production, staging, tests and real email
# delivery never print a code, whatever this says. Codes never reach the
# browser. Leave it off (or unset) on any shared, staging or production
# environment.
AUTH_LOG_OTP=false

# Absolute base URL of this application, used to build links inside emails
# (password reset, email verification). Required and must be HTTPS when
# EMAIL_PROVIDER=resend in production. A bare base address: no query, fragment
# or credentials. Replace with your real deployment URL.
APP_URL=https://app.example.com

# --- Storefront customer accounts (default OFF) ---
# Only the exact value "true" enables customer registration, login, email
# verification and password recovery on storefronts; anything else keeps every
# /api/storefront/account/* route and /account page a 404. Do NOT enable until
# the database indexes in docs/customer-accounts.md exist and email delivery
# (EMAIL_PROVIDER=resend + EMAIL_API_KEY + EMAIL_FROM) is verified.
CUSTOMER_ACCOUNTS_ENABLED=false

# --- Online payment for storefront orders (Razorpay, default OFF) ---
# Each business connects its OWN Razorpay account in Settings; money goes to the
# business. Only the exact value "true" lets checkout offer "Pay online", and
# only for businesses with a connected account. Do NOT enable until the indexes
# in docs/payments-architecture.md exist.
ORDER_ONLINE_PAYMENTS_ENABLED=false
# Live-mode (real money) Razorpay keys are refused unless this is "true".
ORDER_PAYMENTS_LIVE_ALLOWED=false
# Key that encrypts every business's Razorpay secrets at rest (AES-256-GCM).
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it separate from SESSION_SECRET and never commit it. Losing it makes the
# stored secrets unreadable (owners would reconnect their accounts).
PAYMENT_CREDENTIALS_KEY=

# --- AI suggestions: Google Gemini (default OFF) ---
# Kill switch. Only the exact value "true" lets the server call Gemini; a
# GEMINI_API_KEY alone never does. Even when on, each business's owner must
# consent first, and only sanitized store content is sent (never customer,
# order, payment or account data). Keep it OFF in production until the
# activation requirements in docs/ai-website-builder-plan.md are met; test
# real Gemini only in isolated staging (npm run test:staging-ai).
AI_PROVIDER_ENABLED=false
# Server-side only (sent in a request header, never to the browser).
GEMINI_API_KEY=
# Optional: model id (default gemini-3.6-flash); an invalid value disables AI.
GEMINI_MODEL=
# Optional: more Gemini model ids a task may be routed to, comma-separated.
# Listing one does not select it (see /admin/ai-usage for what each task uses).
GEMINI_MODELS=
# Optional: one timeout for the whole provider call, in ms (default 30000).
AI_PROVIDER_TIMEOUT_MS=

# --- Media storage (S3-compatible: AWS S3 or Cloudflare R2) ---
# Used by the business media library (upload/list/delete). All values are
# server-side only; never expose or commit real credentials.
#
# Uploads fail closed with `503 storage_unavailable` when these are missing.
# Grant only PutObject and DeleteObject on the bucket (plus GetObject if the
# bucket is private and served through a signed/CDN path later), ideally
# restricted to the `media/*` prefix.
#
# Uploads are limited to 4 MiB (to stay under the 4.5 MB request-body limit of
# Vercel Functions) and to JPEG, PNG, WebP and GIF, verified by file signature
# (SVG is rejected). Objects are written with their detected Content-Type and
# an immutable cache header.
#
# Cloudflare R2: set S3_ENDPOINT to https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# (an https origin only: no path, query or credentials). S3_REGION then defaults
# to "auto". AWS S3: leave S3_ENDPOINT empty and set S3_REGION.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public base URL used to build delivery URLs (e.g. the R2 bucket's public
# r2.dev / custom domain, https://<bucket>.s3.<region>.amazonaws.com, or a CDN
# hostname). Objects must be publicly readable there, otherwise stored URLs 403.
S3_PUBLIC_URL=
# Optional, for a storage migration only (e.g. AWS S3 -> R2): the OLD bucket's
# public base URL. Image URLs under it are still treated as platform media, so
# tenant ownership checks keep applying to URLs stored before the migration, and
# media deletion counts references in either form. Requires the same object
# keys in the new bucket. Ignored when empty, invalid, identical to
# S3_PUBLIC_URL, or when no S3_PUBLIC_URL is set. Remove it once no stored URL
# uses the old base.
S3_LEGACY_PUBLIC_URL=
#
# Legacy names, still honoured as a fallback for existing local setups:
#   AWS_S3_BUCKET, AWS_S3_PUBLIC_URL      -> fallback everywhere
#   AWS_REGION, AWS_ACCESS_KEY_ID,
#   AWS_SECRET_ACCESS_KEY                 -> fallback only outside production
#                                            and never on Vercel (Vercel injects
#                                            its own unusable AWS_* values).
# In production always set the S3_* variables above.
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_S3_BUCKET=
#AWS_S3_PUBLIC_URL=

# Development-only local disk storage for media (files go to ./media-dev and are
# served by /api/businesses/[id]/local-media). Ignored in production, where S3
# storage is required. Leave unset unless you have no S3 bucket locally.
LOCAL_MEDIA_ENABLED=false

# --- One-time super-admin bootstrap (scripts/create-admin.ts) ---
# Prefer the CLI flags: npm run create-admin -- --email ... --name ... --password ...
# These variables are fallbacks only. Never keep ADMIN_PASSWORD in any .env file;
# if you use them, set them for a single command and unset them afterwards.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# --- Scheduled jobs (optional, docs/scheduled-jobs.md) ---
# A scheduler you run calls the endpoints with "Authorization: Bearer <secret>". They answer
# 503 until their secret is set. None is set up by SiteForge. Use separate random values of
# at least 32 characters; anything shorter counts as not set.
# BILLING_RECONCILE_SECRET=
# DOMAIN_HEALTH_SECRET=
# CART_CLEANUP_SECRET=
# MEDIA_CLEANUP_SECRET=
# CONVERSATION_CLEANUP_SECRET=
# ORDER_EXPIRY_SECRET=
# Optional limits for each (prefix BILLING_RECONCILE_ or DOMAIN_HEALTH_):
# ..._BATCH_SIZE (1-50), ..._MIN_GAP_HOURS (1-168), ..._TIME_BUDGET_SECONDS (30-840).
# ORDER_EXPIRY_ takes ..._BATCH_SIZE and ..._TIME_BUDGET_SECONDS.

# --- Custom domains (optional) ---
# Where owners must point their domains. SiteForge provides no ingress: set these
# only to an address that really serves SiteForge. Without either, no new custom domain can
# become active in production. CUSTOM_DOMAIN_A_RECORDS is a comma-separated IPv4 list.
# CUSTOM_DOMAIN_CNAME_TARGET=
# CUSTOM_DOMAIN_A_RECORDS=
# Which certificate integration to use (lib/domains/certificates.ts). "tls_probe" only
# checks that the domain presents a valid certificate: it issues and renews nothing. Unset
# means no new custom domain can become active in production. Domains verified before
# activation existed keep working.
# CUSTOM_DOMAIN_CERT_PROVIDER=
